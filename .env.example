# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID_PREFIX=veilwatch

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (PostGIS) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veilwatch
POSTGRES_USER=veilwatch
POSTGRES_PASSWORD=change_me_in_secrets_manager

# --- Frame blob store (POC: local FS; staging: MinIO; prod: S3 WORM) ---
FRAME_STORE_BACKEND=local
FRAME_STORE_LOCAL_PATH=/var/veilwatch/frames
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=veilwatch
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=veilwatch-frames

# --- Capture service ---
CAPTURE_CAMERA_ID=CAM-01
CAPTURE_CAMERA_LAT=17.9712
CAPTURE_CAMERA_LON=-76.7920
RTSP_URL=rtsp://host.docker.internal:8554/stream
CAPTURE_TARGET_FPS=5
CAPTURE_JPEG_QUALITY=85

# --- Detection service ---
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=cpu
YOLO_CONF_THRESHOLD=0.35
WATCHLIST_SEED_PATH=/etc/veilwatch/watchlist_seed.json
WATCHLIST_MATCH_THRESHOLD=0.62
# ALPR (Phase 1.5). 'mock' works anywhere; 'openalpr' needs the alpr binary on PATH.
ALPR_BACKEND=mock
ALPR_MIN_CONFIDENCE=0.55
# Re-identification (Phase 2). 'mock' works anywhere; 'onnx' requires an
# OSNet ONNX model vendored in the container at REID_ONNX_MODEL_PATH.
REID_BACKEND=mock
REID_ONNX_MODEL_PATH=/etc/veilwatch/osnet.onnx

# --- Tracker service (Phase 2) ---
TRACKER_MATCH_THRESHOLD=0.72
TRACKER_RECENCY_SECONDS=300
TRACKER_MAX_IDENTITIES=10000
TRACKER_CENTROID_ALPHA=0.2

# --- Confirmation service ---
CONFIRMATION_AUTOCONFIRM_THRESHOLD=0.85
CONFIRMATION_OPERATOR_REVIEW_THRESHOLD=0.55
CONFIRMATION_TRACK_WINDOW_SECONDS=30
CONFIRMATION_HTTP_PORT=8080

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
